DJANGO_SECRET_KEY=replace-this-in-development-and-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=sauti_yetu
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Starting upload limit; admins change it later in System settings.
MAX_VIDEO_UPLOAD_MB=500
# Encrypts SMTP passwords and API keys in the database. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
DEFAULT_FROM_EMAIL="Ndimi <no-reply@jeotamedia.com>"
# Production database (Neon). The website and the dub worker use the same one.
# DATABASE_URL=postgresql://...
# Shared file storage (Cloudflare R2). Set the same values on Vercel and on the worker.
# R2_BUCKET=ndimi-media
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Worker scratch folder (put it on a persistent volume on the worker host).
# DUB_WORK_ROOT=/data/jobs
